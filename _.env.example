# Slack Configuration
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Anthropic Configuration
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# CVaaS Configuration
# Get token from CVaaS Settings > Access Control > Service Accounts
# IMPORTANT: Use the correct regional URL for your CVaaS tenant
# Examples: www.arista.io, www.cv-prod-us-central1-c.arista.io, www.cv-prod-euwest1.arista.io
CVAAS_URL=https://www.arista.io
CVAAS_TOKEN=your-cvaas-service-account-token

# MCP Server Path (relative to slack_bot.py)
MCP_SERVER_PATH=./mcp_server/cvaas_server.py
